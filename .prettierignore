# Prettier also honours .gitignore, so dist/, node_modules/ and /report/ are
# already excluded. This file is for things that are tracked but must not be
# reformatted.

# Generated by pnpm. Prettier has no business rewriting a lockfile: the file is
# a resolver output, not source, and reformatting it creates diff noise on every
# install for no readability gain.
pnpm-lock.yaml

# Golden frames. These are byte-exact terminal output — the whole point is that
# they change only when the rendered layout changes. Prettier touching one would
# be indistinguishable from a real layout regression.
test/__snapshots__/

{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",

    /* AGENTS.md §7 — the non-negotiable floor. Do not weaken these. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    /* Chosen on top of the mandated floor. Rationale in v1_STAGE_1.md §4. */
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    /* tsup owns emit; tsc is a checker only. */
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "*.config.ts"],
  // Fixtures are DATA, not code. test/fixtures/basic/src/index.ts is a file
  // whose only job is to exist and be listed; typechecking it fails on
  // verbatimModuleSyntax and tells us nothing.
  "exclude": ["node_modules", "dist", "test/fixtures"]
}

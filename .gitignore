# ───────────────────────── dependencies ─────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ADR-0001 — pnpm is the package manager for this repo.
# Any of these appearing here is a bug, not a preference.
package-lock.json
yarn.lock
bun.lockb
bun.lock
.yarn/
.npm/

# ───────────────────────── build output ─────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ───────────────────────── test + coverage ──────────────────────
coverage/
.nyc_output/
*.lcov
.vitest/
vitest.config.*.timestamp*

# Fixtures that cannot be committed: FIFOs, sockets, device nodes and
# mode-000 directories (Stage 3 adversaries A1/A9). They are created at
# test time by the harness and must never enter the object database.
test/fixtures/**/.generated/

# ───────────────────────── environment ──────────────────────────
.env
.env.*
!.env.example

# ───────────────────────── logs + runtime ───────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
pids/
*.pid
*.seed

# glim writes its debug sink here — AGENTS.md §7 forbids console.log in
# src/, so diagnostics go to a file instead of corrupting the frame.
.glim-debug.log

# ───────────────────────── editors + IDE ────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# ───────────────────────── OS cruft ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ───────────────────────── documentation ────────────────────────
# docs/ is DELIBERATELY NOT IGNORED. Do not re-add it here.
#
# It was ignored on 2026-08-16 and that cost us 16 files: while another branch
# still tracked docs/, moving across the untracking commit deleted them from the
# working tree. Git was correct — tracked at source, absent at target — and had
# no idea the files mattered. Everything was recovered, and the directory was
# put back under version control so it cannot happen again.
#
# Full write-up: docs/INCIDENT-2026-08-16-docs-loss.md
# If you want the docs off a public remote, move them OUT of this repository
# rather than ignoring them in place.
docs/
# ───────────────────────── misc ─────────────────────────────────
.cache/
tmp/
temp/
*.tgz

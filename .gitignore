# ───────────────────────── dependencies ─────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ADR-0001 — pnpm is the package manager for this repo.
# Any of these appearing here is a bug, not a preference.
package-lock.json
yarn.lock
bun.lockb
bun.lock
.yarn/
.npm/

# ───────────────────────── build output ─────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ───────────────────────── test + coverage ──────────────────────
coverage/
.nyc_output/
*.lcov
.vitest/
vitest.config.*.timestamp*

# Fixtures that cannot be committed: FIFOs, sockets, device nodes and
# mode-000 directories (Stage 3 adversaries A1/A9). They are created at
# test time by the harness and must never enter the object database.
test/fixtures/**/.generated/

# ───────────────────────── environment ──────────────────────────
.env
.env.*
!.env.example

# ───────────────────────── logs + runtime ───────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
pids/
*.pid
*.seed

# glim writes its debug sink here — AGENTS.md §7 forbids console.log in
# src/, so diagnostics go to a file instead of corrupting the frame.
.glim-debug.log

# ───────────────────────── editors + IDE ────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# ───────────────────────── OS cruft ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ───────────────────────── documentation ────────────────────────
# docs/ is DELIBERATELY NOT IGNORED. It is the public documentation for this
# project and it ships with the repository. Do not re-add it here.
#
# Ignoring it has been tried twice and cost us both times. The second time is
# the instructive one: a bare `docs/` pattern is UNANCHORED, so it matches every
# directory named docs at any depth — including test/fixtures/basic/docs/, which
# is a test fixture, not documentation. Untracking it turned CI red on a fresh
# checkout while the working tree still looked fine locally.
#
# If you want documentation off a public remote, move it OUT of this repository
# rather than ignoring it in place.

# The private learning journal. The LEADING SLASH is load-bearing: it anchors
# the pattern to the repository root, so this can never swallow a nested
# test/fixtures/**/report/ the way `docs/` swallowed the fixture above.
/report/
# ───────────────────────── misc ─────────────────────────────────
.cache/
tmp/
temp/
*.tgz

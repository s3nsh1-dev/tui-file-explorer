# ───────────────────────── dependencies ─────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ADR-0001 — pnpm is the package manager for this repo.
# Any of these appearing here is a bug, not a preference.
package-lock.json
yarn.lock
bun.lockb
bun.lock
.yarn/
.npm/

# ───────────────────────── build output ─────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ───────────────────────── test + coverage ──────────────────────
coverage/
.nyc_output/
*.lcov
.vitest/
vitest.config.*.timestamp*

# Fixtures that cannot be committed: FIFOs, sockets, device nodes and
# mode-000 directories (Stage 3 adversaries A1/A9). They are created at
# test time by the harness and must never enter the object database.
test/fixtures/**/.generated/

# ───────────────────────── environment ──────────────────────────
.env
.env.*
!.env.example

# ───────────────────────── logs + runtime ───────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
pids/
*.pid
*.seed

# glim writes its debug sink here — AGENTS.md §7 forbids console.log in
# src/, so diagnostics go to a file instead of corrupting the frame.
.glim-debug.log

# ───────────────────────── editors + IDE ────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# ───────────────────────── OS cruft ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ───────────────────────── misc ─────────────────────────────────
.cache/
tmp/
temp/
*.tgz
